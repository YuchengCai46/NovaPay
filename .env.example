# ===== NovaPay V6.0 环境变量示例 =====
# 复制为 .env 后填入真实值；生产环境务必使用强随机值。

# 数据库连接串（开发用 SQLite；生产可换 PostgreSQL）
DATABASE_URL=sqlite:///./novapay.db

# JWT 签名密钥（请使用强随机字符串，至少 32 字节）
JWT_SECRET_KEY=change-me-please-use-a-long-random-secret-key

# AES-256-GCM 加密密钥（建议 32 字节；若长度不足将用 SHA-256 派生为 32 字节）
# 用于加密：CVV、用户建议内容
AES_ENCRYPTION_KEY=change-me-32-byte-aes-key-please!!!

# Admin 登录账号（进入后台需此账号）
ADMIN_USERNAME=admin
# Admin 密码 Argon2id 哈希（可用 python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))" 生成）
ADMIN_PASSWORD_HASH=

# 可选：邮件通知（SMTP）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 是否调试模式
FLASK_DEBUG=false
